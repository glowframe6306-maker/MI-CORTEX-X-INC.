{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{admin.html,admin-login.html}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/api/index?route=/admin" },
    { "source": "/admin/dashboard", "destination": "/api/index?route=/admin/dashboard" },
    { "source": "/admin.html", "destination": "/api/index?route=/admin.html" },
    { "source": "/admin-login.html", "destination": "/api/index?route=/admin-login.html" },
    { "source": "/api/:path*", "destination": "/api/index?route=/api/:path*" }
  ],
  "crons": [
    { "path": "/api/cron/cleanup", "schedule": "0 3 * * *" }
  ]
}
